<?xml version="1.0" encoding="utf-8"?>
<!--
    Unlist launcher icon foreground: a simple stroked "U" mark, white on the brand-color
    background from ic_launcher_background.xml. Kept well inside the ~66dp adaptive-icon safe
    zone (centered circle within the 108x108 viewport) so it isn't clipped by circle/squircle/
    rounded-square masks across different launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M40,32 L40,60 A14,14 0 0 0 68,60 L68,32"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
