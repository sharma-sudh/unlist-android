<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".UnlistApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unlist">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.Unlist">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share target: lets a user share a Cars24/Spinny listing URL straight into Unlist -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Deep link for shared report links produced by the Share action, e.g.
                 unlist://report/<id>. Kept alongside the https:// App Link below purely so the
                 backend's web fallback page (applinks.py's render_report_page) can still target
                 the app directly via intent://report/<id>#Intent;scheme=unlist;...;end — that
                 bypasses App Link verification, which is fine there since the user already
                 explicitly tapped an "Open in app" button while looking at that exact page. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unlist" android:host="report" />
            </intent-filter>

            <!-- Verified App Link for shared report links, e.g.
                 https://unlist-backend-s280.onrender.com/report/<id> — this is what the Share
                 action itself now generates (see Constants.deepLinkFor). autoVerify="true" makes
                 Android check /.well-known/assetlinks.json on this host at install time; if it
                 matches this app's signing certificate, links to this host open Unlist directly
                 instead of a browser. Host here MUST exactly match Constants.APP_LINK_HOST and
                 the domain applinks.py serves assetlinks.json from. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="unlist-backend-s280.onrender.com"
                    android:pathPrefix="/report/" />
            </intent-filter>
        </activity>
    </application>

</manifest>
